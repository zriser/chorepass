# App
TZ=America/New_York
SESSION_SECRET=change-me-to-a-long-random-string
DB_PATH=/app/data/chores.db
# First-boot seed only — after that, change retention under Settings → history retention.
HISTORY_RETENTION_DAYS=90

# Parent auth — first boot hashes PARENT_PIN_DEFAULT into the settings table; change PIN in-app afterward.
PARENT_PIN_DEFAULT=0000

# Pi-hole v6 (group IDs resolved by name at runtime)
PIHOLE_HOST=https://192.168.1.254
PIHOLE_PW=
PIHOLE_UNBLOCKED_GROUP=Kids_Unblocked
PIHOLE_BLOCKED_GROUP=Kids_Blocked

# UniFi (UniFi OS controller — legacy cookie auth)
UNIFI_HOST=https://192.168.1.10
UNIFI_USER=chore-bot
UNIFI_PW=
UNIFI_SITE=default
# traffic_rule: toggle a per-kid Traffic Rule named `chorepass:<slug>` (kid stays on Wi-Fi, only internet drops).
#   Requires one rule per kid pre-created via the v2 API or UniFi UI, disabled, action=BLOCK,
#   matching_target=INTERNET, target_devices=[kid MACs].
# mac_block: legacy per-MAC block (`cmd/stamgr block-sta`) — disconnects the device from Wi-Fi entirely.
UNIFI_ENFORCEMENT_MODE=traffic_rule
